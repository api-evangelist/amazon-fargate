          "name": "Amazon Fargate Run a Task",
          "request": {
            "name": "Amazon Fargate Run a Task",
            "description": {
              "content": "Starts a new task using the specified task definition on Fargate launch type. You can run tasks on Fargate using the awsvpc network mode.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "hash": "RunTask",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "AWS Region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
