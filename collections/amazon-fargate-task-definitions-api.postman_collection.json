          "name": "Amazon Fargate Register a Task Definition",
          "request": {
            "name": "Amazon Fargate Register a Task Definition",
            "description": {
              "content": "Registers a new task definition from the supplied family and containerDefinitions. Optionally, you can add data volumes to your containers with the volumes parameter. The task definition requires a launch type of FARGATE to run on Fargate.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "hash": "RegisterTaskDefinition",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
